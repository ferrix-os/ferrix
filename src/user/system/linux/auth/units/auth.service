# authd (docs/AUTH.md §3.2). It starts as root to prepare the store and
# import the image's seeds, then becomes the `auth` user before it answers
# anyone, so there is no User= here: authd drops the privilege itself, and
# refuses to start if it cannot.
[Unit]
Description=The authentication service
Requires=auth.socket
After=auth.socket

[Service]
Type=simple
# Watched from its loop (docs/WATCHDOG-STAGES.md §5.5): the loop turns at
# least once a second, a password's hash takes well under that, and a loop
# that has not turned for 20 s is stuck: it is aborted, killed and started
# again, and auth.socket keeps the listener meanwhile. NotifyFd= gives a
# simple service the pipe its pings go down, above the socket at 3.
NotifyFd=9
WatchdogSec=20s
TimeoutAbortSec=5s
ExecStart=/sbin/authd
# The seat channel (docs/AUTH.md §3.7): the session's sessiond opens it to
# arm the lock that hyprlock's acceptance grants. Init routes it only to a
# unit that says Uses=ferrix.auth.seat.
Offers=ferrix.auth.seat
Restart=on-failure
RestartSec=1s
MemoryMax=320M
TasksMax=8
