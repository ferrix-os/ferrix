# The settings writer's hostname area (docs/SETTINGS-WRITER.md §5): settingsd,
# root, names the person who asked; a member of wheel, with their own
# password. An administrator may drop the prompt with a drop-in saying
# Methods=none, which authd honours for settings.* services alone.
[Service]
Description=Change the computer's name in Settings
Account=any
Callers=root
TargetGroup=wheel
Methods=password
FailDelaySec=2
