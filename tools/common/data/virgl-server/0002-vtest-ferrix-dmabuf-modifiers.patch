+int virgl_egl_ferrix_dmabuf_modifiers(struct virgl_egl *egl, uint32_t fourcc, int max,
+                                      uint64_t *modifiers, uint32_t *external_only)
+{
+   EGLuint64KHR found[64];
+   EGLBoolean external[64];
+   EGLint count = 0;
+
+   if (!has_bit(egl->extension_bits, EGL_EXT_IMAGE_DMA_BUF_IMPORT_MODIFIERS))
+      return 0;
+   if (max > 64)
+      max = 64;
+   if (max <= 0 ||
+       !eglQueryDmaBufModifiersEXT(egl->egl_display, (EGLint)fourcc, max, found, external, &count))
+      return 0;
+   if (count > max)
+      count = max;
+   for (EGLint i = 0; i < count; i++) {
+      modifiers[i] = found[i];
+      external_only[i] = external[i] ? 1 : 0;
+   }
+   return count;
+}
