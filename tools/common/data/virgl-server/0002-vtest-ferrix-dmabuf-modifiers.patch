+   uint32_t buf[VCMD_FERRIX_DMABUF_MODIFIERS_SIZE];
+   uint32_t resp_buf[VTEST_HDR_SIZE + 1 + 3 * VCMD_FERRIX_DMABUF_MODIFIERS_MAX];
+   uint64_t modifiers[VCMD_FERRIX_DMABUF_MODIFIERS_MAX];
+   uint32_t external_only[VCMD_FERRIX_DMABUF_MODIFIERS_MAX];
+   uint32_t *resp = &resp_buf[VTEST_CMD_DATA_START];
+   int ret, count;
+
+   ret = ctx->input->read(ctx->input, buf, sizeof(buf));
+   if (ret != sizeof(buf))
+      return -1;
+
+   count = virgl_renderer_ferrix_dmabuf_modifiers(buf[VCMD_FERRIX_DMABUF_MODIFIERS_FOURCC],
+                                                  VCMD_FERRIX_DMABUF_MODIFIERS_MAX, modifiers,
+                                                  external_only);
+   if (count < 0)
+      count = 0;
+   if (count > VCMD_FERRIX_DMABUF_MODIFIERS_MAX)
+      count = VCMD_FERRIX_DMABUF_MODIFIERS_MAX;
