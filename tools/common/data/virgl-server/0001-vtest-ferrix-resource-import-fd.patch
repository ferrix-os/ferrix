+   args.format = buf[VCMD_FERRIX_IMPORT_FD_FORMAT];
+   args.bind = buf[VCMD_FERRIX_IMPORT_FD_BIND];
+   args.width = buf[VCMD_FERRIX_IMPORT_FD_WIDTH];
+   args.height = buf[VCMD_FERRIX_IMPORT_FD_HEIGHT];
+   args.depth = 1;
+   args.array_size = 1;
+   modifier = buf[VCMD_FERRIX_IMPORT_FD_MODIFIER_LO] |
+              (uint64_t)buf[VCMD_FERRIX_IMPORT_FD_MODIFIER_HI] << 32;
