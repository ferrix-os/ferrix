From: Sebastian Dauenhauer <info@magical.rocks>
Subject: [PATCH] x86: x-nazuna, the platform as an ASUS ProArt B650-CREATOR describes it

Ferrix's run-nazuna boots on a q35 machine shaped like the customer's PC,
nazuna. With -machine x-nazuna=on the ACPI tables say what that board's AMI
firmware (BIOS 3206) says, and the devices they name are where they say:

* MADT revision 6: local APICs with each core's first thread before any
  second thread, then disabled entries up to 32; I/O APIC 32 at 0xfec00000
  (GSI 0) and a second, 33, at 0xfec01000 (GSI 24); IRQ 0 on GSI 2, IRQ 9
  level and active low; LINT1 NMI edge and active high. The I/O APICs'
  ID registers reset to 32 and 33.
* FADT: a 32-bit PM timer (TMR_VAL_EXT, and the timer counts 32 bits),
  reset by 0xBE to the APM port 0xB2 (which then resets), LEGACY_DEVICES.
* HPET: AMD's vendor id, a 32-bit main counter (no COUNT_SIZE_CAP; every
  timer 32-bit), 14.31818 MHz; the HPET table follows the device.
* IVRS: the HPET and both I/O APICs as special devices; the AMD IOMMU's
  registers at 0xf7500000.

Each piece is a property (hpet x-vendor-id, x-count-32bit, x-period-fs;
ich9 x-pm-tmr-32bit, x-apm-reset) that x-nazuna sets; defaults change
nothing. The ECAM base (0xe0000000) and PM base (0x800) are the firmware's
to program: OVMF built by tools/common/fetch/fetch-ovmf-nazuna.sh.
---
diff --git a/hw/acpi/core.c b/hw/acpi/core.c
index ff16582..c915ece 100644
--- a/hw/acpi/core.c
+++ b/hw/acpi/core.c
@@ -503,13 +503,17 @@ static inline int64_t acpi_pm_tmr_get_clock(void)
 void acpi_pm_tmr_calc_overflow_time(ACPIREGS *ar)
 {
     int64_t d = acpi_pm_tmr_get_clock();
-    ar->tmr.overflow_time = (d + 0x800000LL) & ~0x7fffffLL;
+    if (ar->tmr.wide) {
+        ar->tmr.overflow_time = (d + 0x80000000LL) & ~0x7fffffffLL;
+    } else {
+        ar->tmr.overflow_time = (d + 0x800000LL) & ~0x7fffffLL;
+    }
 }
 
 static uint32_t acpi_pm_tmr_get(ACPIREGS *ar)
 {
     uint32_t d = acpi_pm_tmr_get_clock();
-    return d & 0xffffff;
+    return ar->tmr.wide ? d : d & 0xffffff;
 }
 
 static void acpi_pm_tmr_timer(void *opaque)
diff --git a/hw/i386/acpi-build.c b/hw/i386/acpi-build.c
index 9446a9f..f772ac4 100644
--- a/hw/i386/acpi-build.c
+++ b/hw/i386/acpi-build.c
@@ -32,6 +32,7 @@
 #include "hw/core/cpu.h"
 #include "target/i386/cpu.h"
 #include "hw/timer/hpet.h"
+#include "hw/isa/apm.h"
 #include "hw/acpi/acpi-defs.h"
 #include "hw/acpi/acpi.h"
 #include "hw/acpi/cpu.h"
@@ -188,6 +189,10 @@ static void init_common_fadt_data(MachineState *ms, Object *o,
      * Flags, bit offset 1 - 8042.
      */
     fadt.iapc_boot_arch = iapc_boot_arch_8042();
+    if (X86_MACHINE(ms)->nazuna) {
+        /* LEGACY_DEVICES, as the board's firmware says. */
+        fadt.iapc_boot_arch |= 0x1;
+    }
 
     *data = fadt;
 }
@@ -216,9 +221,18 @@ static void acpi_get_pm_info(MachineState *machine, AcpiPmInfo *pm)
             ICH9_LPC_SMI_NEGOTIATED_FEAT_PROP, NULL);
         struct AcpiGenericAddress r = { .space_id = AML_AS_SYSTEM_IO,
             .bit_width = 8, .address = ICH9_RST_CNT_IOPORT };
+        uint8_t apm_reset = object_property_get_uint(lpc, "x-apm-reset",
+                                                     NULL);
         pm->fadt.reset_reg = r;
         pm->fadt.reset_val = 0xf;
+        if (apm_reset) {
+            pm->fadt.reset_reg.address = APM_CNT_IOPORT;
+            pm->fadt.reset_val = apm_reset;
+        }
         pm->fadt.flags |= 1 << ACPI_FADT_F_RESET_REG_SUP;
+        if (object_property_get_bool(lpc, "x-pm-tmr-32bit", NULL)) {
+            pm->fadt.flags |= 1 << ACPI_FADT_F_TMR_VAL_EXT;
+        }
         pm->cpu_hp_io_base = ICH9_CPU_HOTPLUG_IO_BASE;
         pm->smi_on_cpuhp =
             !!(smi_features & BIT_ULL(ICH9_LPC_SMI_F_CPU_HOTPLUG_BIT));
@@ -1286,6 +1300,22 @@ build_dsdt(GArray *table_data, BIOSLinker *linker,
  * IA-PC HPET (High Precision Event Timers) Specification (Revision: 1.0a)
  * 3.2.4The ACPI 2.0 HPET Description Table (HPET)
  */
+/* The low half of the HPET's capabilities register. */
+static uint32_t hpet_block_id(void)
+{
+    Object *hpet = object_resolve_type_unambiguous(TYPE_HPET, NULL);
+    uint32_t id = 0x8086a201;
+
+    if (hpet) {
+        id = object_property_get_uint(hpet, "x-vendor-id", NULL) << 16 |
+             0x8001 |
+             (object_property_get_bool(hpet, "x-count-32bit", NULL) ?
+              0 : 0x2000) |
+             (object_property_get_uint(hpet, "timers", NULL) - 1) << 8;
+    }
+    return id;
+}
+
 static void
 build_hpet(GArray *table_data, BIOSLinker *linker, const char *oem_id,
            const char *oem_table_id)
@@ -1297,8 +1327,8 @@ build_hpet(GArray *table_data, BIOSLinker *linker, const char *oem_id,
     /* Note timer_block_id value must be kept in sync with value advertised by
      * emulated hpet
      */
-    /* Event Timer Block ID */
-    build_append_int_noprefix(table_data, 0x8086a201, 4);
+    /* Event Timer Block ID, as the HPET's capabilities say */
+    build_append_int_noprefix(table_data, hpet_block_id(), 4);
     /* BASE_ADDRESS */
     build_append_gas(table_data, AML_AS_SYSTEM_MEMORY, 0, 0, 0, HPET_BASE);
     /* HPET Number */
@@ -1796,11 +1826,32 @@ build_amd_iommu(GArray *table_data, BIOSLinker *linker, const char *oem_id,
      * See Linux kernel commit 'c2ff5cf5294bcbd7fa50f7d860e90a66db7e5059'
      */
     if (x86_iommu_ir_supported(x86_iommu_get_default())) {
-        build_append_int_noprefix(ivhd_blob,
-                                 (0x1ull << 56) |           /* type IOAPIC */
-                                 (IOAPIC_SB_DEVID << 40) |  /* IOAPIC devid */
-                                 0x48,                      /* special device */
-                                 8);
+        X86MachineState *x86ms = X86_MACHINE(qdev_get_machine());
+
+        if (x86ms->nazuna) {
+            /* The HPET and both I/O APICs, as the board's IVRS has them. */
+            build_append_int_noprefix(ivhd_blob,
+                                     (0x2ull << 56) |       /* type HPET */
+                                     (IOAPIC_SB_DEVID << 40) |
+                                     (0x0ull << 32) |       /* handle */
+                                     0x48, 8);
+            build_append_int_noprefix(ivhd_blob,
+                                     (0x1ull << 56) |
+                                     (IOAPIC_SB_DEVID << 40) |
+                                     ((uint64_t)NAZUNA_IOAPIC_ID << 32) |
+                                     0x48, 8);
+            build_append_int_noprefix(ivhd_blob,
+                                     (0x1ull << 56) |
+                                     ((uint64_t)NAZUNA_IOAPIC2_DEVID << 40) |
+                                     ((uint64_t)NAZUNA_IOAPIC2_ID << 32) |
+                                     0x48, 8);
+        } else {
+            build_append_int_noprefix(ivhd_blob,
+                                     (0x1ull << 56) |       /* type IOAPIC */
+                                     (IOAPIC_SB_DEVID << 40) |
+                                     0x48,                  /* special device */
+                                     8);
+        }
     }
 
     /* IVHD definition - type 10h */
diff --git a/hw/i386/acpi-common.c b/hw/i386/acpi-common.c
index 7bd0806..1117527 100644
--- a/hw/i386/acpi-common.c
+++ b/hw/i386/acpi-common.c
@@ -88,6 +88,58 @@ build_xrupt_override(GArray *entry, uint8_t src, uint32_t gsi, uint16_t flags)
     build_append_int_noprefix(entry, flags, 2);  /* Flags */
 }
 
+/*
+ * x-nazuna's MADT, as the board's AMI firmware writes it (revision 6): the
+ * processors' local APICs with each core's first thread before any second
+ * thread, then disabled entries up to 32; I/O APIC 32 at 0xfec00000 from
+ * GSI 0 and 33 at 0xfec01000 from GSI 24; IRQ 0 on GSI 2 and the SCI, IRQ
+ * 9, level and active low; and LINT1 as the NMI of every processor, edge and
+ * active high.
+ */
+static void acpi_build_madt_nazuna(GArray *table_data, BIOSLinker *linker,
+                                   X86MachineState *x86ms,
+                                   const CPUArchIdList *apic_ids,
+                                   AcpiTable *table)
+{
+    int thread, i;
+
+    acpi_table_begin(table, table_data);
+    build_append_int_noprefix(table_data, APIC_DEFAULT_ADDRESS, 4);
+    build_append_int_noprefix(table_data,
+                              x86ms->pic != ON_OFF_AUTO_OFF ? 1 : 0, 4);
+    for (thread = 0; thread < 2; thread++) {
+        for (i = 0; i < apic_ids->len; i++) {
+            const CpuInstanceProperties *props = &apic_ids->cpus[i].props;
+            int which = props->has_thread_id ? props->thread_id : 0;
+
+            if (which == thread || (thread == 1 && which > 1)) {
+                pc_madt_cpu_entry(i, apic_ids, table_data, false);
+            }
+        }
+    }
+    for (i = apic_ids->len; i < 32; i++) {
+        build_append_int_noprefix(table_data, 0, 1);  /* Type */
+        build_append_int_noprefix(table_data, 8, 1);  /* Length */
+        build_append_int_noprefix(table_data, i, 1);  /* ACPI Processor ID */
+        build_append_int_noprefix(table_data, 0, 1);  /* APIC ID */
+        build_append_int_noprefix(table_data, 0, 4);  /* Flags: disabled */
+    }
+    build_ioapic(table_data, NAZUNA_IOAPIC_ID, IO_APIC_DEFAULT_ADDRESS, 0);
+    if (x86ms->ioapic2) {
+        build_ioapic(table_data, NAZUNA_IOAPIC2_ID, NAZUNA_IOAPIC2_ADDRESS,
+                     IO_APIC_SECONDARY_IRQBASE);
+    }
+    build_xrupt_override(table_data, 0, 2, 0);
+    build_xrupt_override(table_data, 9, 9,
+        0xf /* Flags: Active low, Level Triggered */);
+    build_append_int_noprefix(table_data, 4, 1);    /* Type: Local APIC NMI */
+    build_append_int_noprefix(table_data, 6, 1);    /* Length */
+    build_append_int_noprefix(table_data, 0xFF, 1); /* all processors */
+    build_append_int_noprefix(table_data, 5, 2);    /* Edge, active high */
+    build_append_int_noprefix(table_data, 1, 1);    /* LINT1 */
+    acpi_table_end(linker, table);
+}
+
 /*
  * ACPI spec, Revision 1.0b
  * 5.2.8 Multiple APIC Description Table
@@ -101,9 +153,13 @@ void acpi_build_madt(GArray *table_data, BIOSLinker *linker,
     MachineClass *mc = MACHINE_GET_CLASS(x86ms);
     X86MachineClass *x86mc = X86_MACHINE_GET_CLASS(x86ms);
     const CPUArchIdList *apic_ids = mc->possible_cpu_arch_ids(MACHINE(x86ms));
-    AcpiTable table = { .sig = "APIC", .rev = 3, .oem_id = oem_id,
-                        .oem_table_id = oem_table_id };
+    AcpiTable table = { .sig = "APIC", .rev = x86ms->nazuna ? 6 : 3,
+                        .oem_id = oem_id, .oem_table_id = oem_table_id };
 
+    if (x86ms->nazuna) {
+        acpi_build_madt_nazuna(table_data, linker, x86ms, apic_ids, &table);
+        return;
+    }
     acpi_table_begin(&table, table_data);
     /* Local APIC Address */
     build_append_int_noprefix(table_data, APIC_DEFAULT_ADDRESS, 4);
diff --git a/hw/i386/amd_iommu.c b/hw/i386/amd_iommu.c
index d689a06..a5d795c 100644
--- a/hw/i386/amd_iommu.c
+++ b/hw/i386/amd_iommu.c
@@ -285,6 +285,18 @@ static void amdvi_setevent_bits(uint64_t *buffer, uint64_t value, int start,
  *    48:63  -> event type + miscellaneous info
  *    64:127 -> related address
  */
+/* Where the registers are: the board's address under x-nazuna. */
+static uint64_t amdvi_base_addr(void)
+{
+    Object *machine = qdev_get_machine();
+
+    if (object_dynamic_cast(machine, TYPE_X86_MACHINE) &&
+        X86_MACHINE(machine)->nazuna) {
+        return NAZUNA_AMDVI_BASE_ADDR;
+    }
+    return AMDVI_BASE_ADDR;
+}
+
 static void amdvi_encode_event(uint64_t *evt, uint16_t devid, uint64_t addr,
                                uint16_t info)
 {
@@ -2443,9 +2455,9 @@ static void amdvi_pci_realize(PCIDevice *pdev, Error **errp)
     /* reset AMDVI specific capabilities, all r/o */
     pci_set_long(pdev->config + s->capab_offset, AMDVI_CAPAB_FEATURES);
     pci_set_long(pdev->config + s->capab_offset + AMDVI_CAPAB_BAR_LOW,
-                 AMDVI_BASE_ADDR & MAKE_64BIT_MASK(14, 18));
+                 amdvi_base_addr() & MAKE_64BIT_MASK(14, 18));
     pci_set_long(pdev->config + s->capab_offset + AMDVI_CAPAB_BAR_HIGH,
-                AMDVI_BASE_ADDR >> 32);
+                amdvi_base_addr() >> 32);
     pci_set_long(pdev->config + s->capab_offset + AMDVI_CAPAB_RANGE,
                  0xff000000);
     pci_set_long(pdev->config + s->capab_offset + AMDVI_CAPAB_MISC, 0);
@@ -2554,7 +2566,7 @@ static void amdvi_sysbus_realize(DeviceState *dev, Error **errp)
     /* set up MMIO */
     memory_region_init_io(&s->mr_mmio, OBJECT(s), &mmio_mem_ops, s,
                           "amdvi-mmio", AMDVI_MMIO_SIZE);
-    memory_region_add_subregion(get_system_memory(), AMDVI_BASE_ADDR,
+    memory_region_add_subregion(get_system_memory(), amdvi_base_addr(),
                                 &s->mr_mmio);
 
     /* Create the share memory regions by all devices */
diff --git a/hw/i386/pc.c b/hw/i386/pc.c
