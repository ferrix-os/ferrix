# The DK1 card's boot lines, one [section] per kernel image (rotate.ps1).
#
# Every line is typed at U-Boot's prompt and the next one waits for the
# prompt to come back; the last line of a section boots. Addresses are the
# board's U-Boot defaults: kernel_addr_r 0xc2000000, fdt_addr_r 0xc4000000,
# ramdisk_addr_r 0xc4400000. OP-TEE owns 0xde000000 to the end of the
# 512 MiB.
#
# Ferrix's loader reads FERRIX/KERNEL.ELF, INITRD.IMG and DEFAULTS.TXT at
# fixed paths, so a Ferrix image is made the active one by copying it there
# from its bench/ferrix/<tag>/ directory with fatwrite before bootefi. This
# writes the card on each Ferrix boot; nothing else is written.
# FERRIX/CMDLINE.TXT, the card owner's file, is read before DEFAULTS.TXT and
# wins on every key both set, so the card carries it empty (stage it from
# board-bench/card-extra); an empty file is ignored.

[ferrix-main]
load mmc 0:4 ${kernel_addr_r} bench/ferrix/main/KERNEL.ELF
fatwrite mmc 0:4 ${kernel_addr_r} FERRIX/KERNEL.ELF ${filesize}
load mmc 0:4 ${kernel_addr_r} bench/ferrix/main/INITRD.IMG
fatwrite mmc 0:4 ${kernel_addr_r} FERRIX/INITRD.IMG ${filesize}
load mmc 0:4 ${kernel_addr_r} bench/ferrix/main/DEFAULTS.TXT
fatwrite mmc 0:4 ${kernel_addr_r} FERRIX/DEFAULTS.TXT ${filesize}
load mmc 0:4 ${kernel_addr_r} EFI/BOOT/BOOTARM.EFI
bootefi ${kernel_addr_r} ${fdtcontroladdr}

# Level 4 (B5) on Ferrix: lmbench and speedtest1, the same binaries and
# busybox as [linux-posix] (os07/ferrix-posix, measurement only).
[ferrix-posix]
load mmc 0:4 ${kernel_addr_r} bench/ferrix/posix/KERNEL.ELF
fatwrite mmc 0:4 ${kernel_addr_r} FERRIX/KERNEL.ELF ${filesize}
load mmc 0:4 ${kernel_addr_r} bench/ferrix/posix/INITRD.IMG
fatwrite mmc 0:4 ${kernel_addr_r} FERRIX/INITRD.IMG ${filesize}
load mmc 0:4 ${kernel_addr_r} bench/ferrix/posix/DEFAULTS.TXT
fatwrite mmc 0:4 ${kernel_addr_r} FERRIX/DEFAULTS.TXT ${filesize}
load mmc 0:4 ${kernel_addr_r} EFI/BOOT/BOOTARM.EFI
bootefi ${kernel_addr_r} ${fdtcontroladdr}

# Linux 7.2.9 (B1, tools/common/bench/board/linux/boot-linux.cmd): its own
# device tree, which reserves nothing for OP-TEE, so the lines add OP-TEE's
# 32 MiB as no-map; the initramfs is a raw gzip cpio given as addr:size.
[linux]
setenv bootargs console=ttySTM0,115200 maxcpus=1 cpufreq.off=1 panic=-1
load mmc 0:4 0xc2000000 bench/linux/zImage
load mmc 0:4 0xc4000000 bench/linux/stm32mp157a-dk1.dtb
fdt addr 0xc4000000
fdt resize 1024
fdt mknode /reserved-memory optee@de000000
fdt set /reserved-memory/optee@de000000 reg <0xde000000 0x2000000>
fdt set /reserved-memory/optee@de000000 no-map
load mmc 0:4 0xc4400000 bench/linux/initramfs.cpio.gz
bootz 0xc2000000 0xc4400000:${filesize} 0xc4000000

# The second table: both cores.
[linux-smp2]
setenv bootargs console=ttySTM0,115200 cpufreq.off=1 panic=-1
load mmc 0:4 0xc2000000 bench/linux/zImage
load mmc 0:4 0xc4000000 bench/linux/stm32mp157a-dk1.dtb
fdt addr 0xc4000000
fdt resize 1024
fdt mknode /reserved-memory optee@de000000
fdt set /reserved-memory/optee@de000000 reg <0xde000000 0x2000000>
fdt set /reserved-memory/optee@de000000 no-map
load mmc 0:4 0xc4400000 bench/linux/initramfs.cpio.gz
bootz 0xc2000000 0xc4400000:${filesize} 0xc4000000

# Level 4 (B5): lmbench and speedtest1 under Linux, one core. The same
# kernel and tree; the initramfs runs posix-init.sh instead of lbench.
[linux-posix]
setenv bootargs console=ttySTM0,115200 maxcpus=1 cpufreq.off=1 panic=-1 ST_SIZE=60
load mmc 0:4 0xc2000000 bench/linux/zImage
load mmc 0:4 0xc4000000 bench/linux/stm32mp157a-dk1.dtb
fdt addr 0xc4000000
fdt resize 1024
fdt mknode /reserved-memory optee@de000000
fdt set /reserved-memory/optee@de000000 reg <0xde000000 0x2000000>
fdt set /reserved-memory/optee@de000000 no-map
load mmc 0:4 0xc4400000 bench/linux/initramfs-posix.cpio.gz
bootz 0xc2000000 0xc4400000:${filesize} 0xc4000000

# seL4 (B2, tools/common/bench/board/sel4/ on os4b/b2-sel4): ELF images
# loaded at 0xc2000000 and unpacked by bootelf -p (load only), caches off
# first because this U-Boot's bootelf no longer turns them off, then the
# elfloader's entry. sel4bench's root task ends with board-bench end sel4rt
# and resets through RCC MPSYSRST.
[sel4]
load mmc 0:4 0xc2000000 bench/sel4/sel4bench.elf
dcache off
icache off
bootelf -p 0xc2000000
go 0xc0147000

# sel4test (debug) checks the port. It ends with "Test suite passed" (or
# failed) and the kernel halts: no reset, so rotate.ps1 asks for a press.
[sel4test]
load mmc 0:4 0xc2000000 bench/sel4/sel4test.elf
dcache off
icache off
bootelf -p 0xc2000000
go 0xc0498000
