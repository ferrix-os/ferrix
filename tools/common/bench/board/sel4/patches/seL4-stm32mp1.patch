+ * Copyright 2026, Sebastian Dauenhauer
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+#include <sel4/config.h>
+#include <sel4/arch/constants_cortex_a7.h>
+
+/* (Deprecated) First address in the virtual address space that is not accessible to user level.
+ * The kernel window starts here: 0xe0000000 to 0xfff00000 holds the DK1's
+ * 480 MiB of RAM below OP-TEE (0xc0000000 to 0xde000000). */
+#define seL4_UserTop 0xe0000000
+
+/* Last address in the virtual address space that is accessible to user level */
+#define seL4_UserVSpaceTop (seL4_UserTop - 1)
diff --git a/src/arch/arm/armv/armv7-a/user_access.c b/src/arch/arm/armv/armv7-a/user_access.c
index c758a787..eddcb73f 100644
--- a/src/arch/arm/armv/armv7-a/user_access.c
+++ b/src/arch/arm/armv/armv7-a/user_access.c
@@ -64,12 +64,15 @@ static void check_export_pmu(void)
     v |= PMUSERENR_ENABLE;
     MCR(PMUSERENR, v);
 
+#ifndef CONFIG_PLAT_STM32MP1
     /* enable user-level pmu event counter if we're in secure mode */
     if (!(readDscrCp() & DBGDSCR_SECURE_MODE_DISABLED)) {
         MRC(DBGSDER, v);
         v |= DBGSDER_ENABLE_SECURE_USER_NON_INVASIVE_DEBUG;
         MCR(DBGSDER, v);
     }
+#endif /* !CONFIG_PLAT_STM32MP1: always non-secure there (OP-TEE is the
+        * monitor), where SDER is UNDEFINED; skip the debug-register probe */
 #endif
 }
 
diff --git a/src/arch/arm/kernel/boot.c b/src/arch/arm/kernel/boot.c
index 98598d24..67569fdd 100644
--- a/src/arch/arm/kernel/boot.c
+++ b/src/arch/arm/kernel/boot.c
@@ -385,6 +385,15 @@ static BOOT_CODE bool_t try_init_kernel(
 
     /* debug output via serial port is only available from here */
     printf("Bootstrapping kernel\n");
+#if defined(CONFIG_ARCH_AARCH32) && defined(CONFIG_PRINTING)
+    {
+        /* The caches, predictors and coherency the kernel runs with, for
+         * boards that compare kernels. */
+        word_t sctlr;
+        asm volatile("mrc p15, 0, %0, c1, c0, 0" : "=r"(sctlr));
+        printf("SCTLR 0x%"SEL4_PRIx_word" ACTLR 0x%"SEL4_PRIx_word"\n", sctlr, getACTLR());
+    }
+#endif
 
     /* initialise the platform */
     init_plat();
diff --git a/src/plat/stm32mp1/config.cmake b/src/plat/stm32mp1/config.cmake
new file mode 100644
index 00000000..612eb42c
--- /dev/null
+++ b/src/plat/stm32mp1/config.cmake
@@ -0,0 +1,45 @@
+#
+# Copyright 2020, Data61, CSIRO (ABN 41 687 119 230)
+# Copyright 2026, Sebastian Dauenhauer
+#
+# SPDX-License-Identifier: GPL-2.0-only
+#
+
+# STM32MP157 (two Cortex-A7, GIC-400, Arm generic timer) on the STM32MP157D-DK1,
+# modelled on imx7 and allwinnerA20. The board boots TF-A, OP-TEE as the
+# secure monitor and U-Boot, so seL4 runs in the non-secure world.
+declare_platform(stm32mp1 KernelPlatformStm32mp1 PLAT_STM32MP1 KernelSel4ArchAarch32)
+
+if(KernelPlatformStm32mp1)
+    declare_seL4_arch(aarch32)
+    set(KernelArmCortexA7 ON)
+    set(KernelArchArmV7a ON)
+    config_set(KernelARMPlatform ARM_PLAT stm32mp157a-dk1)
+    # Linux's stm32mp157a-dk1.dts (the D-DK1 is electrically the DK1; mainline
+    # has no stm32mp157d-dk1.dts), then the overlay: the kernel's devices and
+    # OP-TEE's reserved memory.
+    list(APPEND KernelDTSList "tools/dts/stm32mp157a-dk1.dts")
+    list(APPEND KernelDTSList "src/plat/stm32mp1/overlay-stm32mp1.dts")
+    # The system counter runs at 24 MHz on the DK1 (Ferrix measures its
+    # generic timer at 24.000 MHz there). MAX_IRQ leaves room for 256 shared
+    # interrupts; the device tree's highest is SPI 200 (IRQ 232, the PMU), and
+    # the GIC driver sizes its set-up from GICD_TYPER. CLK_MAGIC / 2^CLK_SHIFT
+    # is 1/24, ticks to microseconds (MCS only).
+    declare_default_headers(
+        TIMER_FREQUENCY 24000000
+        MAX_IRQ 287
+        NUM_PPI 32
+        TIMER drivers/timer/arm_generic.h
+        INTERRUPT_CONTROLLER arch/machine/gic_v2.h
+        CLK_MAGIC 2863311531llu
+        CLK_SHIFT 36u
+        KERNEL_WCET 10u
+    )
+endif()
+
+# The Cortex-A7's L2 cache is inside the core cluster, maintained by the
+# architectural set/way operations: no outer cache controller to drive.
+add_sources(
+    DEP "KernelPlatformStm32mp1"
+    CFILES src/arch/arm/machine/gic_v2.c src/arch/arm/machine/l2c_nop.c
+)
