+ * Copyright 2026, Sebastian Dauenhauer
+ *
+ * SPDX-License-Identifier: GPL-2.0-only
+ */
+
+/ {
+	chosen {
+		/* serial0 is UART4 at 0x40010000, the DK1's ST-LINK console. */
+		seL4,elfloader-devices =
+		    "serial0",
+		    &{/psci},
+		    &{/timer};
+
+		seL4,kernel-devices =
+		    "serial0",
+		    &{/interrupt-controller@a0021000},
+		    &{/timer};
+	};
+
+	/* The elfloader starts the second core through OP-TEE's PSCI (SMP
+	 * builds only; a single-core build never calls it). */
+	cpus {
+		cpu@0 {
+			enable-method = "psci";
+		};
+		cpu@1 {
+			enable-method = "psci";
+		};
+	};
+
+	/*
+	 * OP-TEE's secure DDR: CFG_TZDRAM_START 0xde000000, CFG_TZDRAM_SIZE
+	 * 32 MiB in the DK1 firmware's optee-conf.mk. Linux's stm32mp157a-dk1
+	 * tree does not reserve it, and seL4 boots with its own tree, so it is
+	 * reserved here. hardware_gen takes no-map regions out of RAM, so the
+	 * kernel never hands it out as memory and the elfloader places nothing
+	 * in it.
+	 */
+	reserved-memory {
+		optee@de000000 {
+			reg = <0xde000000 0x2000000>;
+			no-map;
+		};
+	};
+};
