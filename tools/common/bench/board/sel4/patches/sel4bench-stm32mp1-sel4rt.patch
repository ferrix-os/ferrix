+/* Run sel4rt (see sel4rt.c) with two processes already configured, before
+ * anything else has run in them, and print its lines, ending with `RT done`.
+ * The client's arguments are rewritten: ep, result ep, touch buffer. */
+void sel4rt_run(env_t *env, sel4utils_process_t *client, char **client_argv,
+                char (*client_argv_strings)[WORD_STRING_SIZE], seL4_CPtr client_ep,
+                seL4_CPtr client_result_ep, sel4utils_process_t *server, char **server_argv,
+                seL4_CPtr result_ep, int num_args);
diff --git a/apps/sel4bench/src/main.c b/apps/sel4bench/src/main.c
index c9a94ed..ffa3ff6 100644
--- a/apps/sel4bench/src/main.c
+++ b/apps/sel4bench/src/main.c
@@ -272,6 +272,52 @@ static void add_iteration_tag(json_t *result, int run)
     }
 }
 
+#ifdef CONFIG_PLAT_STM32MP1
+/*
+ * Reset the STM32MP157 with one register write: 1 to RCC_MP_GRSTCSETR
+ * (0x50000404) bit 0, MPSYSRST, a system reset. The DK1 firmware's OP-TEE
+ * leaves the RCC non-secure ("RCC is non-secure" in its boot log). Not the
+ * IWDG2 watchdog: its APB clock (RCC_MP_APB4ENSETR bit 15) may be off on this
+ * firmware (OP-TEE CFG_STM32_IWDG=n, U-Boot WDT_STM32MP=n), and enabling it
+ * would be a clock write. First about 100 ms on the virtual counter
+ * (KernelArmExportVCNTUser), so the UART's FIFO sends the last line.
+ */
+#include <platsupport/io.h>
+#include <sel4platsupport/io.h>
+
+#ifndef CONFIG_EXPORT_VCNT_USER
+#error "board_bench_reset waits on the virtual counter: KernelArmExportVCNTUser"
+#endif
+
+#define BB_RCC_PADDR            0x50000000u
+#define BB_RCC_MP_GRSTCSETR     0x404u
+#define BB_RCC_MPSYSRST         BIT(0)
+
+static uint64_t bb_reset_cntvct(void)
+{
+    uint32_t lo, hi;
+    __asm__ volatile("isb\n\tmrrc p15, 1, %0, %1, c14" : "=r"(lo), "=r"(hi) : : "memory");
+    return ((uint64_t)hi << 32) | lo;
+}
+
+static void board_bench_reset(env_t *env)
+{
+    ps_io_mapper_t io;
+    int error = sel4platsupport_new_io_mapper(&env->vspace, &env->vka, &io);
+    ZF_LOGF_IF(error, "board-bench reset: no I/O mapper");
+    volatile uint32_t *rcc = ps_io_map(&io, BB_RCC_PADDR, PAGE_SIZE_4K, false, PS_MEM_NORMAL);
+    ZF_LOGF_IF(rcc == NULL, "board-bench reset: cannot map the RCC");
+    uint32_t frq;
+    __asm__ volatile("mrc p15, 0, %0, c14, c0, 0" : "=r"(frq));
+    uint64_t t0 = bb_reset_cntvct();
+    while (bb_reset_cntvct() - t0 < frq / 10u) {
+    }
+    rcc[BB_RCC_MP_GRSTCSETR / 4] = BB_RCC_MPSYSRST;
+    for (;;) {
+    }
+}
+#endif
+
 void *main_continued(void *arg)
 {
 
@@ -323,6 +369,13 @@ void *main_continued(void *arg)
     printf("All is well in the universe.\n");
     printf("\n\nFin\n");
 
+    /* Ferrix's board bench: the run's last line, then (on the DK1) a reset,
+     * so a run needs no hand at the board. */
+    printf("board-bench end sel4rt\n");
+#ifdef CONFIG_PLAT_STM32MP1
+    board_bench_reset(&global_env);
+#endif
+
     return 0;
 }
 
