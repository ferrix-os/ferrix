#!/bin/sh
# Stands in for the Steam Linux Runtime 3 ("steamrt64") entry point, which the
# Steam client runs steamwebhelper through (docs/STEAM.md). Valve's starts
# pressure-vessel, which builds a container with bubblewrap, and Ferrix has
# no user namespaces yet. This one runs the command directly, on Debian 13's
# libraries first and the runtime's own after them. `cargo xtask run-steam`
# carries it at /steam/steamrt, which client.sh names in
# STEAM_RUNTIME_STEAMRT. Owner of the real fix: namespaces N2-N6.
while [ $# -gt 0 ] && [ "$1" != "--" ]; do shift; done
[ "${1-}" = "--" ] && shift
# The platform's libraries, with the soname links client.sh gives them: of
# the platform VERSIONS.txt names. A client update unpacks a new platform
# beside the old one and leaves the old one's directory behind, partly
# emptied; the first directory that matched was then that one, and
# steamwebhelper found none of the runtime's libraries (the N150 box,
# 2026-11-11: "libXdamage.so.1: cannot open shared object file", Steam at
# "Steamwebhelper is not responding" and no game started).
depot=/data/steam/steamrt64/pv-runtime/steam-runtime-steamrt
named=
if [ -r "$depot/VERSIONS.txt" ]; then
    while read -r name version _; do
        case $name in
        steamrt*) named=${name}_platform_$version ;;
        esac
    done < "$depot/VERSIONS.txt"
fi
runtime=
for files in "$depot/$named/files" "$depot"/steamrt*_platform_*/files; do
    [ -d "$files/lib/x86_64-linux-gnu" ] && runtime=$files && break
done
[ -n "$runtime" ] || echo "steam-window: steamrt stand-in finds no Steam Linux Runtime" >&2
export LD_LIBRARY_PATH=/data/steam/ubuntu12_64:/usr/lib/x86_64-linux-gnu:$runtime/lib/x86_64-linux-gnu:$runtime/lib
export LIBGL_DRIVERS_PATH=/usr/lib/x86_64-linux-gnu/dri
unset LD_PRELOAD WAYLAND_DISPLAY
export SDL_VIDEO_DRIVER=x11
echo "steam-window: steamrt stand-in runs $*" >&2
exec "$@"
