# Cargo's output, wherever a workspace or a stray build put it. Builds share
# /target; one run with a target dir of its own belongs under /target too.
target/
/target-remote
/target-*/
# xtask's images, logs and screens.
/build
/build-logs-*/
*.img
*.fd
__pycache__/
/tests/fuzz/artifacts
/remote-desktop.toml
/docs/roadmap/book/
/_site
# Components: repositories of their own, checked out here at their pins by
# xtask (components.toml).
/src/user/system/linux/ferrousli/
/src/user/system/linux/zinc/
/tools/vendor/google/pixel7/
/docs/website/
